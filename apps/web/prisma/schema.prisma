generator client {
  provider = "prisma-client-js"
  seed     = "prisma/seed.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model brews {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  start_date             DateTime  @default(now()) @db.Timestamptz(6)
  end_date               DateTime? @db.Timestamptz(6)
  user_id                Int?
  latest_gravity         Float?    @db.Real
  recipe_id              Int?
  name                   String?
  requested_email_alerts Boolean?  @default(false)
  sb_alert_sent          Boolean?  @default(false)
  fg_alert_sent          Boolean?  @default(false)
  public                 Boolean   @default(false)

  // brew-tracking additions
  stage                   brew_stage   @default(PLANNED)
  batch_number            Int?
  current_volume_liters   Float?       @db.Real
  recipe_snapshot         Json? // keep as Json (no @db.JsonB) to avoid churn vs pulled schema
  gravity_unit_preference gravity_unit @default(SG)

  // relations
  images brew_images[]
  entries brew_entries[]
  recipes recipes?       @relation(fields: [recipe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users   users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  devices devices[]
  logs    logs[]
  equipment equipment[]

  @@unique([id, user_id])
  @@index([user_id, start_date])
  @@index([recipe_id])
}

model brew_entries {
  images brew_images[]
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brew_id  String   @db.Uuid
  user_id  Int?
  datetime DateTime @default(now()) @db.Timestamptz(6)

  type  brew_entry_type
  title String?
  note  String?         @db.Text

  // optional typed fields
  gravity     Float?      @db.Real
  temperature Float?      @db.Real
  temp_units  temp_units?

  // flexible payload
  data Json?

  brews brews  @relation(fields: [brew_id], references: [id], onDelete: Cascade)
  users users? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([brew_id, datetime])
  @@index([brew_id, type])
  @@index([user_id, datetime])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model devices {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_name  String?
  recipe_id    Int?
  user_id      Int
  coefficients Float[] @default([]) @db.Real
  brew_id      String? @db.Uuid

  brews   brews?   @relation(fields: [brew_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipes recipes? @relation(fields: [recipe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users   users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logs    logs[]
}

model ingredients {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(255)
  sugar_content Decimal @db.Decimal
  water_content Decimal @db.Decimal
  category      String  @db.VarChar(255)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model logs {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datetime           DateTime   @default(now()) @db.Timestamptz(6)
  angle              Float      @db.Real
  temperature        Float      @db.Real
  temp_units         temp_units
  battery            Float      @db.Real
  gravity            Float      @db.Real
  interval           Int
  calculated_gravity Float?     @db.Real
  device_id          String?    @db.Uuid
  brew_id            String?    @db.Uuid

  // leaving logs alone if a brew is deleted:
  brews   brews?   @relation(fields: [brew_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  devices devices? @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)

  @@index([brew_id, datetime, id])
}

model recipes {
  id      Int    @id @default(autoincrement())
  user_id Int?
  name    String

  // legacy (keep for now)
  recipeData      String
  yanFromSource   String?
  yanContribution String
  nutrientData    String
  advanced        Boolean
  nuteInfo        String?
  primaryNotes    String[]
  secondaryNotes  String[]

  // NEW
  dataV2  Json?
  version Int   @default(1)

  private               Boolean   @default(false)
  lastActivityEmailAt   DateTime? @db.Timestamptz(6)
  activityEmailsEnabled Boolean   @default(false)

  brews          brews[]
  devices        devices[]
  users          users?                  @relation(fields: [user_id], references: [id])
  comments       comments[]
  ratings        recipe_ratings[]
  daily_activity recipe_daily_activity[]
  chat_drafts    chat_drafts[]
}

model users {
  id                 Int     @id @default(autoincrement())
  email              String  @unique @db.VarChar(255)
  password           String? @db.VarChar(255)
  google_id          String? @db.VarChar(255)
  role               String? @default("user") @db.VarChar(255)
  hydro_token        String? @unique
  public_username    String? @db.VarChar(50)
  google_avatar_url  String?
  show_google_avatar Boolean @default(false)
  active             Boolean @default(true)
  /// Null means the account has not answered the one-time banner.
  product_updates_opt_in Boolean?
  /// Claimed before SMTP to keep automated sends at most once per release.
  product_updates_last_emailed_date DateTime? @db.Date

  brew_images              brew_images[]
  brews                    brews[]
  brew_entries             brew_entries[]
  devices                  devices[]
  recipes                  recipes[]
  comments                 comments[]
  ratings                  recipe_ratings[]
  chat_conversations       chat_conversations[]
  chat_access_grant        chat_access_grants?
  chat_access_changes      chat_access_settings[]     @relation("chat_access_settings_updated_by")
  credit_account           credit_accounts?
  credit_checkout_sessions credit_checkout_sessions[]
  resolved_payment_recoveries credit_payment_recoveries[] @relation("credit_payment_recoveries_resolved_by")
  premium_memberships      premium_memberships[]
  kofi_link                premium_kofi_links?
  kofi_link_challenges     premium_kofi_link_challenges[]
  premium_stripe_checkout premium_stripe_checkouts?
  premium_stripe_subscription premium_stripe_subscriptions?
  premium_stripe_invoices  premium_stripe_invoices[]
  mcp_access_tokens       mcp_access_tokens[]
  mcp_oauth_codes         mcp_oauth_codes[]
  mcp_oauth_sessions      mcp_oauth_sessions[]
  mcp_rate_buckets        mcp_rate_buckets?
  mcp_tool_leases         mcp_tool_leases[]
  mcp_tool_usage          mcp_tool_usage[]
  inventory_stock        inventory_stock[]
  inventory_operations   inventory_operations[]
  equipment              equipment[]
}

/// Archive referenced stock; preserve quantities and audit records after expiry.
model inventory_stock {
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         Int
  name            String @db.VarChar(200)
  category        inventory_stock_category
  catalog         String? @db.VarChar(32)
  catalog_id      String? @db.VarChar(200)
  quantity        Decimal @db.Decimal(16, 6)
  unit            inventory_quantity_unit
  notes           String? @db.VarChar(5000)
  archived_at     DateTime? @db.Timestamptz(6)
  reconciliation_required Boolean @default(false)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user         users @relation(fields: [user_id], references: [id], onDelete: Restrict)
  consumptions inventory_consumptions[]
  adjustments  inventory_adjustments[]

  // The compound key enforces ownership and preserves the historical stock unit.
  @@unique([id, user_id, unit])
  @@index([user_id, archived_at])
  @@index([user_id, catalog, catalog_id])
}

/// One request identity per account, including a saved response for retries.
model inventory_operations {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       Int
  operation_key String @db.Uuid
  request_hash  String @db.VarChar(64)
  result        Json
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  user        users @relation(fields: [user_id], references: [id], onDelete: Restrict)
  adjustments inventory_adjustments[]

  @@unique([user_id, operation_key])
  @@unique([id, user_id])
}

/// Retain the physical-use identity and deduction after entry/brew deletion.
/// Brew and entry IDs are historical snapshots, deliberately not cascading FKs.
model inventory_consumptions {
  line_key       String @default("addition") @db.VarChar(200)
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        Int
  stock_id       String @db.Uuid
  brew_id        String @db.Uuid
  entry_id       String @db.Uuid
  use_key        String @db.Uuid
  deducted       Decimal @db.Decimal(16, 6)
  unit           inventory_quantity_unit
  reversed_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  updated_at     DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  stock       inventory_stock @relation(fields: [stock_id, user_id, unit], references: [id, user_id, unit], onDelete: Restrict, onUpdate: Restrict)
  adjustments inventory_adjustments[]

  @@unique([user_id, use_key])
  @@unique([user_id, entry_id, line_key])
  @@unique([id, user_id])
  @@index([user_id, brew_id, entry_id])
}

/// Append-only audit rows; write with balance, operation and consumption in one transaction.
model inventory_adjustments {
  id             String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id        Int
  stock_id       String @db.Uuid
  operation_id   String @db.Uuid
  consumption_id String? @db.Uuid
  kind           String @db.VarChar(32)
  delta          Decimal @db.Decimal(16, 6)
  balance_after  Decimal @db.Decimal(16, 6)
  unit           inventory_quantity_unit
  note           String? @db.VarChar(5000)
  created_at     DateTime @default(now()) @db.Timestamptz(6)

  stock       inventory_stock @relation(fields: [stock_id, user_id, unit], references: [id, user_id, unit], onDelete: Restrict, onUpdate: Restrict)
  operation   inventory_operations @relation(fields: [operation_id, user_id], references: [id, user_id], onDelete: Restrict, onUpdate: Restrict)
  // Audit stock/unit stays unchanged when a use is corrected to a different item.
  consumption inventory_consumptions? @relation(fields: [consumption_id, user_id], references: [id, user_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([operation_id, stock_id])
  @@index([user_id, stock_id, created_at])
  @@index([consumption_id])
}

model equipment {
  group_id        String @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  label           String? @db.VarChar(100)
  id              String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         Int
  name            String @db.VarChar(200)
  type            equipment_type
  capacity        Decimal? @db.Decimal(16, 6)
  capacity_unit   inventory_quantity_unit?
  notes           String? @db.VarChar(5000)
  current_brew_id String? @db.Uuid
  archived_at     DateTime? @db.Timestamptz(6)
  created_at      DateTime @default(now()) @db.Timestamptz(6)
  updated_at      DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)
  // Release explicitly in the brew completion/deletion transaction.
  brew brews? @relation(fields: [current_brew_id, user_id], references: [id, user_id], onDelete: NoAction, onUpdate: Restrict)
  assignment_events equipment_assignment_events[]

  @@unique([id, user_id])
  @@index([user_id, archived_at])
  @@index([current_brew_id, user_id])
  @@index([user_id, group_id])
}

/// Historical brew IDs survive deletion; one event per retried assignment request.
model equipment_assignment_events {
  id            String @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id       Int
  equipment_id  String @db.Uuid
  operation_key String @db.Uuid
  from_brew_id  String? @db.Uuid
  to_brew_id    String? @db.Uuid
  created_at    DateTime @default(now()) @db.Timestamptz(6)

  equipment equipment @relation(fields: [equipment_id, user_id], references: [id, user_id], onDelete: Restrict, onUpdate: Restrict)

  @@unique([user_id, operation_key, equipment_id])
  @@index([user_id, equipment_id, created_at])
}

enum inventory_stock_category {
  honey
  fruit
  yeast
  additive
  packaging
}

enum equipment_type {
  vessel
  other
}

enum inventory_quantity_unit {
  kg
  g
  mg
  lb
  oz
  L
  mL
  gal
  qt
  pt
  fl_oz
  imp_gal
  imp_qt
  imp_pt
  imp_fl_oz
  tsp
  tbsp
  units
}

/// Account-scoped premium access from a paid period or an operator grant.
/// Source records remain separate so Ko-fi, Stripe, and manual grants can
/// expire or be revoked independently.
model premium_memberships {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            Int
  source             String    @db.VarChar(32)
  external_reference String?   @db.VarChar(255)
  paid_through       DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)
  updated_at         DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([user_id, source])
  @@unique([source, external_reference])
  @@index([user_id, paid_through])
}

/// A verified account link to the Ko-fi payer email. The email itself is not
/// persisted; a keyed digest prevents a database leak from listing supporters.
model premium_kofi_links {
  user_id       Int      @id
  email_digest  String   @unique @db.VarChar(64)
  grandfathered Boolean @default(true)
  verified_at   DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

/// One-time proof sent to the payer email before it can claim Ko-fi payments.
model premium_kofi_link_challenges {
  id          String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id     Int
  email_digest String  @db.VarChar(64)
  token_hash  String    @unique @db.VarChar(64)
  expires_at  DateTime  @db.Timestamptz(6)
  consumed_at DateTime? @db.Timestamptz(6)
  created_at  DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, expires_at])
}

/// One verified Ko-fi recurring payment. The message and transaction IDs
/// deduplicate retries; no raw webhook payload or payer email is retained.
model premium_kofi_payments {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id     String    @unique @db.VarChar(128)
  transaction_id String    @unique @db.VarChar(128)
  email_digest   String    @db.VarChar(64)
  paid_at        DateTime  @db.Timestamptz(6)
  amount_cents   Int
  currency       String    @db.VarChar(3)
  applied_user_id Int?
  applied_at     DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  @@index([email_digest, paid_at])
}

/// Durable Checkout reservation; Stripe requests reuse the persisted attempt and parameters.
model premium_stripe_checkouts {
  user_id Int @id
  attempt_id String @unique @db.Uuid
  params Json
  session_id String? @unique @db.VarChar(255)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

/// Stripe customer and subscription identity for account billing management.
model premium_stripe_subscriptions {
  user_id              Int      @id
  customer_id          String   @unique @db.VarChar(255)
  subscription_id      String   @unique @db.VarChar(255)
  status               String   @db.VarChar(32)
  cancel_at_period_end Boolean  @default(false)
  created_at           DateTime @default(now()) @db.Timestamptz(6)
  updated_at           DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

/// One paid Stripe invoice per premium allowance. The invoice ID makes
/// webhook retries and out-of-order delivery safe to replay.
model premium_stripe_invoices {
  invoice_id        String   @id @db.VarChar(255)
  user_id           Int
  subscription_id   String   @db.VarChar(255)
  paid_at           DateTime @db.Timestamptz(6)
  paid_through      DateTime @db.Timestamptz(6)
  amount_paid_cents Int
  refunded_amount_cents Int @default(0)
  payments premium_stripe_payments[]
  payment_recoveries credit_payment_recoveries[]
  created_at        DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, paid_at])
  @@index([subscription_id, paid_at])
}

/// Verified invoice-to-payment mapping for subscription refunds and disputes.
model premium_stripe_payments {
  payment_intent_id String @id @db.VarChar(255)
  invoice_id String @db.VarChar(255)
  invoice premium_stripe_invoices @relation(fields: [invoice_id], references: [invoice_id], onDelete: Restrict)
  @@index([invoice_id])
}

/// Revocable account-scoped MCP credentials. Only a SHA-256 digest is stored.
model mcp_access_tokens {
  scope        String    @default("mcp:tools") @db.VarChar(128)
  id           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      Int
  label        String    @db.VarChar(80)
  token_hash   String    @unique @db.VarChar(64)
  expires_at   DateTime  @db.Timestamptz(6)
  revoked_at   DateTime? @db.Timestamptz(6)
  last_used_at DateTime? @db.Timestamptz(6)
  created_at   DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, revoked_at])
}

/// Public OAuth clients registered by supported remote MCP clients.
model mcp_oauth_clients {
  client_id     String   @id @db.VarChar(128)
  client_name   String   @db.VarChar(100)
  redirect_uris String[]
  created_at    DateTime @default(now()) @db.Timestamptz(6)
}

/// Single-use authorization codes, bound to a user, client, resource and PKCE challenge.
model mcp_oauth_codes {
  code_hash      String    @id @db.VarChar(64)
  consent_hash   String    @unique @db.VarChar(64)
  user_id        Int
  client_id      String    @db.VarChar(128)
  redirect_uri   String    @db.VarChar(2048)
  code_challenge String    @db.VarChar(128)
  resource       String    @db.VarChar(512)
  scope          String    @db.VarChar(128)
  expires_at     DateTime  @db.Timestamptz(6)
  consumed_at    DateTime? @db.Timestamptz(6)
  created_at     DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, expires_at])
}

/// Revocable OAuth connection; access tokens expire quickly and refresh tokens rotate.
model mcp_oauth_sessions {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            Int
  client_id          String    @db.VarChar(128)
  label              String    @db.VarChar(100)
  access_token_hash  String    @unique @db.VarChar(64)
  refresh_token_hash String    @unique @db.VarChar(64)
  resource           String    @db.VarChar(512)
  scope              String    @db.VarChar(128)
  access_expires_at  DateTime  @db.Timestamptz(6)
  refresh_expires_at DateTime  @db.Timestamptz(6)
  revoked_at         DateTime? @db.Timestamptz(6)
  last_used_at       DateTime? @db.Timestamptz(6)
  created_at         DateTime  @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  consumed_refresh_tokens mcp_oauth_consumed_refresh_tokens[]
  @@index([user_id, revoked_at])
}

/// Hash-only token history identifies replay of a rotated refresh token.
model mcp_oauth_consumed_refresh_tokens {
  token_hash String @id @db.VarChar(64)
  session_id String @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  session mcp_oauth_sessions @relation(fields: [session_id], references: [id], onDelete: Cascade)
  @@index([session_id])
}

/// A global admission budget bounds anonymous registration across instances.
model mcp_registration_budget {
  id Boolean @id @default(true)
  window_start DateTime @db.Timestamptz(6)
  call_count Int
}

/// One rolling minute counter per account; no tool arguments are stored.
model mcp_rate_buckets {
  user_id      Int      @id
  window_start DateTime @db.Timestamptz(6)
  call_count   Int
  updated_at   DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)
}

/// Expiring concurrency slots survive serverless instances and crashes.
model mcp_tool_leases {
  id         String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id    Int
  expires_at DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, expires_at])
}

/// Metadata only: never store tool arguments, results or credentials here.
model mcp_tool_usage {
  id           String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id      Int
  tool_name    String   @db.VarChar(80)
  result_class String   @db.VarChar(40)
  duration_ms  Int
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([user_id, created_at])
}

/// The single rollout policy for private chatbot access. It is intentionally
/// database-backed: access controls and beta grants need an auditable source
/// of truth even when deployment configuration changes.
model chat_access_settings {
  id                 Boolean          @id @default(true)
  mode               chat_access_mode @default(beta_allowlist)
  updated_at         DateTime         @default(now()) @updatedAt @db.Timestamptz(6)
  updated_by_user_id Int?

  updated_by users? @relation("chat_access_settings_updated_by", fields: [updated_by_user_id], references: [id], onDelete: SetNull)
}

/// One durable opt-in record per user. Revoking beta access preserves who
/// granted it and when instead of deleting operational history.
model chat_access_grants {
  id                 String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id            Int       @unique
  granted_at         DateTime  @default(now()) @db.Timestamptz(6)
  granted_by_user_id Int
  revoked_at         DateTime? @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@index([revoked_at])
}

/// A user owns one account. Its available balance is derived from the
/// immutable ledger; do not add a mutable spent or balance column here.
model credit_accounts {
  id                           String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                      Int       @unique
  payment_restricted_at        DateTime? @db.Timestamptz(6)
  payment_restriction_reason   String?   @db.VarChar(255)
  payment_restriction_reference String?  @db.VarChar(255)
  created_at                   DateTime  @default(now()) @db.Timestamptz(6)
  updated_at                   DateTime  @default(now()) @updatedAt @db.Timestamptz(6)

  user    users                   @relation(fields: [user_id], references: [id], onDelete: Restrict)
  entries credit_ledger_entries[]

  @@index([payment_restricted_at])
}

/// Effective-dated provider prices used to calculate the exact cost of an AI
/// operation. Rates are integer picodollars per one million tokens.
model credit_pricing_versions {
  id                                        String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider                                  String    @db.VarChar(64)
  model                                     String    @db.VarChar(255)
  version                                   String    @db.VarChar(96)
  uncached_input_picousd_per_million_tokens BigInt
  cached_input_picousd_per_million_tokens   BigInt
  output_picousd_per_million_tokens         BigInt
  effective_at                              DateTime  @db.Timestamptz(6)
  retired_at                                DateTime? @db.Timestamptz(6)
  created_at                                DateTime  @default(now()) @db.Timestamptz(6)

  ledger_entries credit_ledger_entries[]

  @@unique([provider, model, version])
  @@index([provider, model, effective_at])
}

/// Versioned customer pricing policy. This keeps provider cost, payment fees,
/// and MeadTools' margin independently auditable and adjustable over time.
model credit_fee_policy_versions {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  version              String    @unique @db.VarChar(96)
  markup_basis_points  Int
  fixed_turn_credits   Int       @default(0)
  minimum_turn_credits Int       @default(1)
  effective_at         DateTime  @db.Timestamptz(6)
  retired_at           DateTime? @db.Timestamptz(6)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)

  ledger_entries credit_ledger_entries[]

  @@index([effective_at])
}

/// Append-only financial record for credit purchases, holds, settlement, and
/// reversals. A reservation is negative; settlement returns unused credits,
/// so the sum of immutable deltas is the final user charge.
model credit_ledger_entries {
  id                    String                   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  account_id            String                   @db.Uuid
  operation_id          String                   @db.Uuid
  idempotency_key       String                   @db.VarChar(128)
  entry_type            credit_ledger_entry_type
  credits_delta         Int
  pricing_version_id    String?                  @db.Uuid
  fee_policy_version_id String?                  @db.Uuid
  provider_cost_picousd BigInt?
  source_amount_cents   Int?
  source_currency       String?                  @db.VarChar(3)
  external_reference    String?                  @db.VarChar(255)
  metadata              Json?                    @db.JsonB
  created_at            DateTime                 @default(now()) @db.Timestamptz(6)

  account            credit_accounts             @relation(fields: [account_id], references: [id], onDelete: Restrict)
  pricing_version    credit_pricing_versions?    @relation(fields: [pricing_version_id], references: [id], onDelete: Restrict)
  fee_policy_version credit_fee_policy_versions? @relation(fields: [fee_policy_version_id], references: [id], onDelete: Restrict)

  @@unique([account_id, idempotency_key])
  @@unique([account_id, operation_id, entry_type])
  @@index([account_id, created_at])
  @@index([entry_type, created_at])
  @@index([operation_id])
  @@index([external_reference])
}

/// A pending or completed Stripe Checkout session. Payment is credited only
/// after a verified webhook, never from a browser success redirect.
model credit_checkout_sessions {
  id                         String                         @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id                    Int
  pack_id                    String                         @db.VarChar(64)
  credit_amount              Int
  amount_cents               Int
  currency                   String                         @db.VarChar(3)
  stripe_checkout_session_id String?                        @unique @db.VarChar(255)
  stripe_payment_intent_id   String?                        @unique @db.VarChar(255)
  stripe_amount_total_cents  Int?
  stripe_payment_currency    String?                        @db.VarChar(3)
  refunded_amount_cents      Int                            @default(0)
  status                     credit_checkout_session_status @default(pending)
  created_at                 DateTime                       @default(now()) @db.Timestamptz(6)
  fulfilled_at               DateTime?                      @db.Timestamptz(6)
  refunded_at                DateTime?                      @db.Timestamptz(6)

  user users @relation(fields: [user_id], references: [id], onDelete: Restrict)
  payment_recoveries credit_payment_recoveries[]

  @@index([user_id, status, created_at])
}

/// A Stripe refund or dispute that affects a credit purchase or premium invoice. The
/// provider amount is retained for audit; the ledger remains the source of
/// truth for credit changes.
model credit_payment_recoveries {
  id                      String                          @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  checkout_id             String?                         @db.Uuid
  premium_invoice_id      String?                         @db.VarChar(255)
  recovery_kind           credit_payment_recovery_kind
  status                  credit_payment_recovery_status
  external_reference      String                          @unique @db.VarChar(255)
  amount_cents            Int
  currency                String                          @db.VarChar(3)
  credit_delta            Int?
  resolution_credit_delta Int?
  resolution_note         String?                         @db.Text
  resolved_at             DateTime?                       @db.Timestamptz(6)
  resolved_by_user_id     Int?
  created_at              DateTime                        @default(now()) @db.Timestamptz(6)
  updated_at              DateTime                        @default(now()) @updatedAt @db.Timestamptz(6)

  premium_invoice  premium_stripe_invoices? @relation(fields: [premium_invoice_id], references: [invoice_id], onDelete: Restrict)
  checkout         credit_checkout_sessions? @relation(fields: [checkout_id], references: [id], onDelete: Restrict)
  resolved_by_user users?                   @relation("credit_payment_recoveries_resolved_by", fields: [resolved_by_user_id], references: [id], onDelete: SetNull)

  @@index([status, created_at])
  @@index([checkout_id])
  @@index([premium_invoice_id])
}

/// Deduplicates verified payment provider webhooks. This audit record contains
/// event identity only; Stripe's raw event payload is intentionally not stored.
model credit_payment_webhook_events {
  id                String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  provider          String   @db.VarChar(32)
  external_event_id String   @unique @db.VarChar(255)
  event_type        String   @db.VarChar(128)
  created_at        DateTime @default(now()) @db.Timestamptz(6)
}

/// Retains the minimal non-sensitive fields required to finish a dispute
/// recovery that reaches us before its Checkout fulfillment webhook.
model credit_stripe_dispute_events {
  id                        String                              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_event_id         String                              @unique @db.VarChar(255)
  event_type                String                              @db.VarChar(128)
  stripe_dispute_id         String                              @db.VarChar(255)
  stripe_payment_intent_id  String                              @db.VarChar(255)
  amount_cents              Int
  currency                  String                              @db.VarChar(3)
  status                    credit_stripe_dispute_event_status @default(deferred)
  created_at                DateTime                            @default(now()) @db.Timestamptz(6)
  processed_at              DateTime?                           @db.Timestamptz(6)

  @@index([stripe_payment_intent_id, status])
  @@index([stripe_dispute_id])
}

/// Retains the minimal verified fields required to replay a succeeded refund
/// that arrives before its Checkout fulfillment webhook.
model credit_stripe_refund_events {
  id                       String                             @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  external_event_id        String                             @unique @db.VarChar(255)
  event_type               String                             @db.VarChar(128)
  stripe_refund_id         String                             @db.VarChar(255)
  stripe_payment_intent_id String                             @db.VarChar(255)
  amount_cents             Int
  currency                 String                             @db.VarChar(3)
  status                   credit_stripe_refund_event_status  @default(deferred)
  created_at               DateTime                           @default(now()) @db.Timestamptz(6)
  processed_at             DateTime?                          @db.Timestamptz(6)

  @@index([stripe_payment_intent_id, status])
  @@index([stripe_refund_id])
}

/// Retains aggregate, non-sensitive provider usage for operational auditing.
model chatbot_usage_windows {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             Int
  window              String   @db.VarChar(8)
  window_start        DateTime @db.Timestamptz(6)
  request_count       Int      @default(0)
  provider_calls      Int      @default(0)
  input_tokens        Int      @default(0)
  cached_input_tokens Int      @default(0)
  output_tokens       Int      @default(0)
  total_tokens        Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([user_id, window, window_start])
  @@index([window, window_start])
}

/// Stores request metadata and provider usage only; it intentionally never stores chat content.
model chatbot_usage_events {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id           String    @unique @db.Uuid
  user_id              Int
  environment          String    @db.VarChar(32)
  model                String    @db.VarChar(255)
  status               String    @db.VarChar(16)
  provider_calls       Int       @default(0)
  input_tokens         Int       @default(0)
  cached_input_tokens  Int       @default(0)
  output_tokens        Int       @default(0)
  total_tokens         Int       @default(0)
  provider_request_ids   String[] @default([])
  provider_attempt_count Int      @default(0)
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)

  chat_generations chat_generations[]

  @@index([user_id, created_at])
  @@index([created_at, status])
  @@index([model, created_at])
  @@index([environment, created_at])
  @@index([status, created_at])
}

/// A signed-in user's private chat thread. Transcript content expires after
/// inactivity; provider usage has a separate operational retention policy.
model chat_conversations {
  id               String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id          Int
  title            String                  @db.VarChar(160)
  state            chat_conversation_state @default(active)
  next_sequence    Int                     @default(1)
  message_count    Int                     @default(0)
  content_bytes    Int                     @default(0)
  last_activity_at DateTime                @default(now()) @db.Timestamptz(6)
  expires_at       DateTime                @db.Timestamptz(6)
  created_at       DateTime                @default(now()) @db.Timestamptz(6)
  updated_at       DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  user     users           @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages chat_messages[]
  drafts   chat_drafts[]

  @@index([user_id, state, last_activity_at])
  @@index([expires_at])
}

/// Stores only the transcript the user can see. Provider prompts, hidden
/// reasoning, and raw tool payloads deliberately do not belong here.
model chat_messages {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id   String              @db.Uuid
  sequence          Int
  client_message_id String?             @db.VarChar(128)
  role              chat_message_role
  status            chat_message_status @default(pending)
  content           String              @db.Text
  citations         Json?               @db.JsonB
  draft_id          String?             @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  completed_at      DateTime?           @db.Timestamptz(6)

  conversation chat_conversations      @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  draft        chat_drafts?            @relation("ChatDraftMessage", fields: [draft_id], references: [id], onDelete: SetNull)
  generation   chat_generations?
  contexts     chat_message_contexts[]

  @@unique([conversation_id, sequence])
  @@unique([conversation_id, client_message_id])
  @@index([conversation_id, created_at])
}

/// Versioned, validated recipe state for a chat thread. This is not a saved
/// MeadTools recipe and is retained/deleted with the conversation.
model chat_drafts {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id    String   @db.Uuid
  revision           Int
  recipe_draft_input Json?
  recipe_data        Json?
  saved_recipe_id    Int?
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  conversation chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  saved_recipe recipes?           @relation(fields: [saved_recipe_id], references: [id], onDelete: SetNull)
  messages     chat_messages[]    @relation("ChatDraftMessage")

  @@unique([conversation_id, revision])
  @@index([conversation_id, created_at])
}

/// The generation is addressable without retaining a raw provider request.
/// Usage lives in chatbot_usage_events and will later be priced by an
/// effective-dated provider pricing version.
model chat_generations {
  id             String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id     String    @unique @db.Uuid
  usage_event_id String?   @db.Uuid
  provider       String    @db.VarChar(64)
  model          String    @db.VarChar(255)
  status         String    @db.VarChar(16)
  latency_ms     Int?
  created_at     DateTime  @default(now()) @db.Timestamptz(6)
  completed_at   DateTime? @db.Timestamptz(6)

  message     chat_messages         @relation(fields: [message_id], references: [id], onDelete: Cascade)
  usage_event chatbot_usage_events? @relation(fields: [usage_event_id], references: [id], onDelete: SetNull)

  @@index([usage_event_id])
  @@index([provider, model, created_at])
}

/// References only the user-selected record identity and display label for a
/// turn. These references never implicitly reattach account context later.
model chat_message_contexts {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id String            @db.Uuid
  kind       chat_context_kind
  record_id  String            @db.VarChar(64)
  label      String            @db.VarChar(240)
  created_at DateTime          @default(now()) @db.Timestamptz(6)

  message chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, kind, record_id])
  @@index([record_id, kind])
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model yeasts {
  id                   Int     @id @default(autoincrement())
  brand                String  @db.VarChar(255)
  name                 String  @db.VarChar(255)
  nitrogen_requirement String  @db.VarChar(255)
  tolerance            Decimal @db.Decimal
  low_temp             Decimal @db.Decimal
  high_temp            Decimal @db.Decimal
}

model additives {
  id         String        @id @default(uuid()) @db.Uuid
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  name       String
  dosage     Float         @default(0)
  unit       additive_unit
}

model nutrient_presets {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String  @unique
  yan_ppm_per_gpl    Float
  max_gpl            Float?
  organic_multiplier Boolean @default(false)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BjcpIngredient {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  label      String?  @unique
  category   String?
  value      String?  @unique

  @@map("bjcp-ingredients")
}

model comments {
  id String @id @default(uuid()) @db.Uuid

  recipe_id Int
  user_id   Int
  parent_id String? @db.Uuid

  comment String @db.Text

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  recipe recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author users   @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  parent  comments?  @relation("CommentToReplies", fields: [parent_id], references: [id], onDelete: SetNull)
  replies comments[] @relation("CommentToReplies")

  @@index([recipe_id, created_at])
  @@index([parent_id, created_at])
}

model recipe_ratings {
  id String @id @default(uuid()) @db.Uuid

  recipe_id Int
  user_id   Int
  rating    Int @db.SmallInt

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt

  recipe recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  user   users   @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([recipe_id, user_id])
  @@index([recipe_id])
  @@index([user_id])
}

model recipe_daily_activity {
  id        Int @id @default(autoincrement())
  recipe_id Int

  summary_date DateTime @db.Date
  changes      Json?
  emailed      Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  recipe recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@unique([recipe_id, summary_date])
  @@index([recipe_id])
  @@index([summary_date, emailed])
}

enum temp_units {
  F
  C
  K
}

enum gravity_unit {
  SG
  BRIX
}

enum additive_unit {
  g
  ml
  tsp
  oz
  units
  mg
  kg
  lbs
  liters
  fl_oz  @map("fl oz")
  quarts
  gal
  tbsp
}

enum brew_entry_type {
  NOTE
  GRAVITY
  VOLUME
  TEMPERATURE
  PH
  ADDITION
  NUTRIENT
  RACKING
  STABILIZATION
  BACKSWEETENING
  PACKAGING
  TASTING
  STAGE_CHANGE
  ISSUE
}

enum brew_stage {
  PLANNED
  PRIMARY
  SECONDARY
  BULK_AGE
  STABILIZED
  BACKSWEETENED
  PACKAGED
  COMPLETE
}

enum chat_conversation_state {
  active
  archived
}

enum chat_message_role {
  user
  assistant
}

enum chat_message_status {
  pending
  complete
  failed
  cancelled
}

enum chat_context_kind {
  recipe
  brew
}

enum credit_ledger_entry_type {
  purchase
  grant
  reservation
  settlement
  reversal
  refund
  adjustment
}

enum credit_checkout_session_status {
  pending
  fulfilled
  failed
  expired
  refunded
}

enum credit_payment_recovery_kind {
  stripe_refund
  stripe_dispute
}

enum credit_payment_recovery_status {
  applied
  review_required
  resolved
}

enum credit_stripe_dispute_event_status {
  deferred
  processed
}

enum credit_stripe_refund_event_status {
  deferred
  processed
}

enum chat_access_mode {
  beta_allowlist
  all_active_users
}

/// Durable upload reservations and cleanup survive brew deletion.
model brew_images {
  id String @id @db.Uuid
  brew_id String? @db.Uuid
  original_brew_id String @db.Uuid
  entry_id String? @db.Uuid
  original_entry_id String? @db.Uuid
  user_id Int
  status String @db.VarChar(16)
  request_hash String @db.VarChar(64)
  image_key String
  thumbnail_key String
  caption String @default("") @db.VarChar(500)
  width Int @default(0)
  height Int @default(0)
  size_bytes Int @default(0)
  reserved_bytes Int
  attempts Int @default(1)
  removed Boolean @default(false)
  cleanup_after DateTime @db.Timestamptz(6)
  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt @db.Timestamptz(6)
  entry brew_entries? @relation(fields: [entry_id], references: [id], onDelete: SetNull)
  brew brews? @relation(fields: [brew_id], references: [id], onDelete: SetNull)
  user users @relation(fields: [user_id], references: [id], onDelete: NoAction)
  @@index([user_id, status])
  @@index([brew_id, status])
  @@index([entry_id, status])
  @@index([status, cleanup_after])
}
