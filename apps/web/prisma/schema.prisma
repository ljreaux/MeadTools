generator client {
  provider = "prisma-client-js"
  seed     = "prisma/seed.ts"
}

datasource db {
  provider  = "postgresql"
  url       = env("DATABASE_URL")
  directUrl = env("DATABASE_DIRECT_URL")
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model brews {
  id                     String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  start_date             DateTime  @default(now()) @db.Timestamptz(6)
  end_date               DateTime? @db.Timestamptz(6)
  user_id                Int?
  latest_gravity         Float?    @db.Real
  recipe_id              Int?
  name                   String?
  requested_email_alerts Boolean?  @default(false)
  sb_alert_sent          Boolean?  @default(false)
  fg_alert_sent          Boolean?  @default(false)
  public                 Boolean   @default(false)

  // brew-tracking additions
  stage                   brew_stage   @default(PLANNED)
  batch_number            Int?
  current_volume_liters   Float?       @db.Real
  recipe_snapshot         Json? // keep as Json (no @db.JsonB) to avoid churn vs pulled schema
  gravity_unit_preference gravity_unit @default(SG)

  // relations
  entries brew_entries[]
  recipes recipes?       @relation(fields: [recipe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users   users?         @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  devices devices[]
  logs    logs[]

  @@index([user_id, start_date])
  @@index([recipe_id])
}

model brew_entries {
  id       String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  brew_id  String   @db.Uuid
  user_id  Int?
  datetime DateTime @default(now()) @db.Timestamptz(6)

  type  brew_entry_type
  title String?
  note  String?         @db.Text

  // optional typed fields
  gravity     Float?      @db.Real
  temperature Float?      @db.Real
  temp_units  temp_units?

  // flexible payload
  data Json?

  brews brews  @relation(fields: [brew_id], references: [id], onDelete: Cascade)
  users users? @relation(fields: [user_id], references: [id], onDelete: SetNull)

  @@index([brew_id, datetime])
  @@index([brew_id, type])
  @@index([user_id, datetime])
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model devices {
  id           String  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  device_name  String?
  recipe_id    Int?
  user_id      Int
  coefficients Float[] @default([]) @db.Real
  brew_id      String? @db.Uuid

  brews   brews?   @relation(fields: [brew_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  recipes recipes? @relation(fields: [recipe_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  users   users    @relation(fields: [user_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  logs    logs[]
}

model ingredients {
  id            Int     @id @default(autoincrement())
  name          String  @db.VarChar(255)
  sugar_content Decimal @db.Decimal
  water_content Decimal @db.Decimal
  category      String  @db.VarChar(255)
}

/// This model contains row level security and requires additional setup for migrations. Visit https://pris.ly/d/row-level-security for more info.
model logs {
  id                 String     @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  datetime           DateTime   @default(now()) @db.Timestamptz(6)
  angle              Float      @db.Real
  temperature        Float      @db.Real
  temp_units         temp_units
  battery            Float      @db.Real
  gravity            Float      @db.Real
  interval           Int
  calculated_gravity Float?     @db.Real
  device_id          String?    @db.Uuid
  brew_id            String?    @db.Uuid

  // leaving logs alone if a brew is deleted:
  brews   brews?   @relation(fields: [brew_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
  devices devices? @relation(fields: [device_id], references: [id], onDelete: NoAction, onUpdate: NoAction)
}

model recipes {
  id      Int    @id @default(autoincrement())
  user_id Int?
  name    String

  // legacy (keep for now)
  recipeData      String
  yanFromSource   String?
  yanContribution String
  nutrientData    String
  advanced        Boolean
  nuteInfo        String?
  primaryNotes    String[]
  secondaryNotes  String[]

  // NEW
  dataV2  Json?
  version Int   @default(1)

  private               Boolean   @default(false)
  lastActivityEmailAt   DateTime? @db.Timestamptz(6)
  activityEmailsEnabled Boolean   @default(false)

  brews          brews[]
  devices        devices[]
  users          users?                  @relation(fields: [user_id], references: [id])
  comments       comments[]
  ratings        recipe_ratings[]
  daily_activity recipe_daily_activity[]
  chat_drafts    chat_drafts[]
}

model users {
  id                 Int     @id @default(autoincrement())
  email              String  @unique @db.VarChar(255)
  password           String? @db.VarChar(255)
  google_id          String? @db.VarChar(255)
  role               String? @default("user") @db.VarChar(255)
  hydro_token        String? @unique
  public_username    String? @db.VarChar(50)
  google_avatar_url  String?
  show_google_avatar Boolean @default(false)
  active             Boolean @default(true)

  brews        brews[]
  brew_entries brew_entries[]
  devices      devices[]
  recipes      recipes[]
  comments     comments[]
  ratings      recipe_ratings[]
  chat_conversations chat_conversations[]
}

/// Retains aggregate limits and non-sensitive provider usage for chatbot cost control.
model chatbot_usage_windows {
  id                  String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id             Int
  window              String   @db.VarChar(8)
  window_start        DateTime @db.Timestamptz(6)
  request_count       Int      @default(0)
  provider_calls      Int      @default(0)
  input_tokens        Int      @default(0)
  cached_input_tokens Int      @default(0)
  output_tokens       Int      @default(0)
  total_tokens        Int      @default(0)
  created_at          DateTime @default(now()) @db.Timestamptz(6)
  updated_at          DateTime @default(now()) @updatedAt @db.Timestamptz(6)

  @@unique([user_id, window, window_start])
  @@index([window, window_start])
}

/// Stores request metadata and provider usage only; it intentionally never stores chat content.
model chatbot_usage_events {
  id                   String    @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  request_id           String    @unique @db.Uuid
  user_id              Int
  environment          String    @db.VarChar(32)
  model                String    @db.VarChar(255)
  status               String    @db.VarChar(16)
  provider_calls       Int       @default(0)
  input_tokens         Int       @default(0)
  cached_input_tokens  Int       @default(0)
  output_tokens        Int       @default(0)
  total_tokens         Int       @default(0)
  provider_request_ids String[]  @default([])
  created_at           DateTime  @default(now()) @db.Timestamptz(6)
  completed_at         DateTime? @db.Timestamptz(6)

  chat_generations chat_generations[]

  @@index([user_id, created_at])
  @@index([environment, created_at])
  @@index([status, created_at])
}

/// A signed-in user's private chat thread. Transcript content expires after
/// inactivity; provider usage has a separate operational retention policy.
model chat_conversations {
  id              String                  @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  user_id         Int
  title           String                  @db.VarChar(160)
  state           chat_conversation_state @default(active)
  next_sequence   Int                     @default(1)
  message_count   Int                     @default(0)
  content_bytes   Int                     @default(0)
  last_activity_at DateTime                @default(now()) @db.Timestamptz(6)
  expires_at      DateTime                @db.Timestamptz(6)
  created_at      DateTime                @default(now()) @db.Timestamptz(6)
  updated_at      DateTime                @default(now()) @updatedAt @db.Timestamptz(6)

  user     users                  @relation(fields: [user_id], references: [id], onDelete: Cascade)
  messages chat_messages[]
  drafts   chat_drafts[]

  @@index([user_id, state, last_activity_at])
  @@index([expires_at])
}

/// Stores only the transcript the user can see. Provider prompts, hidden
/// reasoning, and raw tool payloads deliberately do not belong here.
model chat_messages {
  id                String              @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id   String              @db.Uuid
  sequence          Int
  client_message_id String?             @db.VarChar(128)
  role              chat_message_role
  status            chat_message_status @default(pending)
  content           String              @db.Text
  citations         Json?               @db.JsonB
  draft_id          String?             @db.Uuid
  created_at        DateTime            @default(now()) @db.Timestamptz(6)
  completed_at      DateTime?           @db.Timestamptz(6)

  conversation chat_conversations    @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  draft        chat_drafts?           @relation("ChatDraftMessage", fields: [draft_id], references: [id], onDelete: SetNull)
  generation   chat_generations?
  contexts     chat_message_contexts[]

  @@unique([conversation_id, sequence])
  @@unique([conversation_id, client_message_id])
  @@index([conversation_id, created_at])
}

/// Versioned, validated recipe state for a chat thread. This is not a saved
/// MeadTools recipe and is retained/deleted with the conversation.
model chat_drafts {
  id                 String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  conversation_id    String   @db.Uuid
  revision           Int
  recipe_draft_input Json?
  recipe_data        Json?
  saved_recipe_id    Int?
  created_at         DateTime @default(now()) @db.Timestamptz(6)

  conversation chat_conversations @relation(fields: [conversation_id], references: [id], onDelete: Cascade)
  saved_recipe recipes?           @relation(fields: [saved_recipe_id], references: [id], onDelete: SetNull)
  messages     chat_messages[]    @relation("ChatDraftMessage")

  @@unique([conversation_id, revision])
  @@index([conversation_id, created_at])
}

/// The generation is addressable without retaining a raw provider request.
/// Usage lives in chatbot_usage_events and will later be priced by an
/// effective-dated provider pricing version.
model chat_generations {
  id             String   @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id     String   @unique @db.Uuid
  usage_event_id String?  @db.Uuid
  provider       String   @db.VarChar(64)
  model          String   @db.VarChar(255)
  status         String   @db.VarChar(16)
  latency_ms     Int?
  created_at     DateTime @default(now()) @db.Timestamptz(6)
  completed_at   DateTime? @db.Timestamptz(6)

  message     chat_messages         @relation(fields: [message_id], references: [id], onDelete: Cascade)
  usage_event chatbot_usage_events? @relation(fields: [usage_event_id], references: [id], onDelete: SetNull)

  @@index([usage_event_id])
  @@index([provider, model, created_at])
}

/// References only the user-selected record identity and display label for a
/// turn. These references never implicitly reattach account context later.
model chat_message_contexts {
  id         String            @id @default(dbgenerated("gen_random_uuid()")) @db.Uuid
  message_id String            @db.Uuid
  kind       chat_context_kind
  record_id  String            @db.VarChar(64)
  label      String            @db.VarChar(240)
  created_at DateTime          @default(now()) @db.Timestamptz(6)

  message chat_messages @relation(fields: [message_id], references: [id], onDelete: Cascade)

  @@unique([message_id, kind, record_id])
  @@index([record_id, kind])
}

model User {
  id            String    @id @default(cuid())
  email         String?   @unique
  name          String?
  emailVerified DateTime?
  image         String?
  accounts      Account[]
  sessions      Session[]
}

model yeasts {
  id                   Int     @id @default(autoincrement())
  brand                String  @db.VarChar(255)
  name                 String  @db.VarChar(255)
  nitrogen_requirement String  @db.VarChar(255)
  tolerance            Decimal @db.Decimal
  low_temp             Decimal @db.Decimal
  high_temp            Decimal @db.Decimal
}

model additives {
  id         String        @id @default(uuid()) @db.Uuid
  created_at DateTime      @default(now()) @db.Timestamptz(6)
  name       String
  dosage     Float         @default(0)
  unit       additive_unit
}

model nutrient_presets {
  id                 String  @id @default(uuid()) @db.Uuid
  name               String  @unique
  yan_ppm_per_gpl    Float
  max_gpl            Float?
  organic_multiplier Boolean @default(false)
}

model Account {
  id                String  @id @default(cuid())
  userId            String
  type              String
  provider          String
  providerAccountId String
  refresh_token     String?
  access_token      String?
  expires_at        Int?
  token_type        String?
  scope             String?
  id_token          String?
  session_state     String?
  user              User    @relation(fields: [userId], references: [id], onDelete: Cascade)

  @@unique([provider, providerAccountId])
}

model Session {
  id           String   @id @default(cuid())
  sessionToken String   @unique
  userId       String
  expires      DateTime
  user         User     @relation(fields: [userId], references: [id], onDelete: Cascade)
}

model VerificationToken {
  identifier String
  token      String   @unique
  expires    DateTime

  @@unique([identifier, token])
}

model BjcpIngredient {
  id         String   @id @default(uuid()) @db.Uuid
  created_at DateTime @default(now()) @db.Timestamptz(6)
  label      String?  @unique
  category   String?
  value      String?  @unique

  @@map("bjcp-ingredients")
}

model comments {
  id String @id @default(uuid()) @db.Uuid

  recipe_id Int
  user_id   Int
  parent_id String? @db.Uuid

  comment String @db.Text

  created_at DateTime  @default(now()) @db.Timestamptz(6)
  updated_at DateTime  @updatedAt
  deleted_at DateTime?

  recipe recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade, onUpdate: NoAction)
  author users   @relation(fields: [user_id], references: [id], onDelete: Restrict, onUpdate: NoAction)

  parent  comments?  @relation("CommentToReplies", fields: [parent_id], references: [id], onDelete: SetNull)
  replies comments[] @relation("CommentToReplies")

  @@index([recipe_id, created_at])
  @@index([parent_id, created_at])
}

model recipe_ratings {
  id String @id @default(uuid()) @db.Uuid

  recipe_id Int
  user_id   Int
  rating    Int @db.SmallInt

  created_at DateTime @default(now()) @db.Timestamptz(6)
  updated_at DateTime @updatedAt

  recipe recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade)
  user   users   @relation(fields: [user_id], references: [id], onDelete: Restrict)

  @@unique([recipe_id, user_id])
  @@index([recipe_id])
  @@index([user_id])
}

model recipe_daily_activity {
  id        Int @id @default(autoincrement())
  recipe_id Int

  summary_date DateTime @db.Date
  changes      Json?
  emailed      Boolean  @default(false)
  created_at   DateTime @default(now()) @db.Timestamptz(6)

  recipe recipes @relation(fields: [recipe_id], references: [id], onDelete: Cascade)

  @@unique([recipe_id, summary_date])
  @@index([recipe_id])
  @@index([summary_date, emailed])
}

enum temp_units {
  F
  C
  K
}

enum gravity_unit {
  SG
  BRIX
}

enum additive_unit {
  g
  ml
  tsp
  oz
  units
  mg
  kg
  lbs
  liters
  fl_oz  @map("fl oz")
  quarts
  gal
  tbsp
}

enum brew_entry_type {
  NOTE
  GRAVITY
  VOLUME
  TEMPERATURE
  PH
  ADDITION
  NUTRIENT
  RACKING
  STABILIZATION
  BACKSWEETENING
  PACKAGING
  TASTING
  STAGE_CHANGE
  ISSUE
}

enum brew_stage {
  PLANNED
  PRIMARY
  SECONDARY
  BULK_AGE
  STABILIZED
  BACKSWEETENED
  PACKAGED
  COMPLETE
}

enum chat_conversation_state {
  active
  archived
}

enum chat_message_role {
  user
  assistant
}

enum chat_message_status {
  pending
  complete
  failed
  cancelled
}

enum chat_context_kind {
  recipe
  brew
}
