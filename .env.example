# ==================================================
# Database (local Docker Postgres)
# ==================================================
DATABASE_URL=postgresql://meadtools:meadtools@localhost:54329/meadtools_dev

# ==================================================
# App base URL (used by server-side API calls)
# ==================================================
NEXT_PUBLIC_BASE_URL=http://localhost:3000

# ==================================================
# Database seeding (dev only)
# ==================================================
# These users are created when running the seed script
ADMIN_EMAIL=admin@example.com
ADMIN_PASSWORD=meadtools_admin

# Must be different from ADMIN_EMAIL
USER_EMAIL=user@example.com
USER_PASSWORD=meadtools_user

# ==================================================
# Email (contact form / notifications)
# ==================================================
# Optional for dev; leave blank if not testing email
EMAIL_USER=
EMAIL_PASS=

# ==================================================
# Custom Auth (required)
# ==================================================
# Generate strong random values for real use
ACCESS_TOKEN_SECRET=dev_access_token_secret
REFRESH_TOKEN_SECRET=dev_refresh_token_secret

# ==================================================
# NextAuth (optional in dev)
# ==================================================
# Google auth is disabled by default in dev
# GOOGLE_CLIENT_ID=
# GOOGLE_CLIENT_SECRET=
# GOOGLE_IOS_CLIENT_ID=
# GOOGLE_ANDROID_CLIENT_ID=
# NEXTAUTH_URL=http://localhost:3000
# NEXTAUTH_SECRET=

# ==================================================
# Safety guard
# ==================================================
# Must be explicitly set to allow destructive DB operations
ALLOW_DB_RESET=true

# ==================================================
# Hosted chatbot (disabled by default)
# ==================================================
# Keep the provider key only in .env.local. Chat fails closed unless both
# values are set. Grant access through the admin panel; do not maintain an
# environment allowlist of user IDs.
# CHATBOT_ENABLED=true
# OPENAI_API_KEY=
# Optional audit label; defaults to VERCEL_ENV or local.
# CHATBOT_USAGE_ENVIRONMENT=local
# Optional: defaults to the reviewed pinned OpenAI model and bounded limits.
# CHATBOT_OPENAI_MODEL=gpt-5.4-mini-2026-03-17
# CHATBOT_MAX_OUTPUT_TOKENS=4000
# CHATBOT_MAX_TOOL_CALLS=7
# CHATBOT_MAX_PROVIDER_CALLS=10
# CHATBOT_MAX_TOTAL_OUTPUT_TOKENS=8000
# CHATBOT_MAX_PROVIDER_INPUT_CHARACTERS=60000
# CHATBOT_MAX_TOTAL_PROVIDER_TOKENS=60000

# ==================================================
# Chat credit purchases (disabled by default)
# ==================================================
# Leave disabled except for a supervised production payment smoke test.
# Enabling purchases also requires both Stripe keys and exposes Checkout to eligible users.
# CHAT_CREDIT_PURCHASES_ENABLED=false
# STRIPE_SECRET_KEY=
# STRIPE_WEBHOOK_SECRET=
# Production Checkout uses these three live catalog prices. Local sandbox
# sessions can still use inline prices when they are unset.
# STRIPE_CREDIT_PRICE_STARTER=
# STRIPE_CREDIT_PRICE_STANDARD=
# STRIPE_CREDIT_PRICE_RESERVE=

# ==================================================
# Premium subscriptions (local testing only; sales disabled by default)
# ==================================================
# The Ko-fi webhook also needs KOFI_VERIFICATION_TOKEN and
# KOFI_EMAIL_DIGEST_SECRET. Account linking sends a real one-time email using
# EMAIL_USER and EMAIL_PASS.
# KOFI_VERIFICATION_TOKEN=
# KOFI_EMAIL_DIGEST_SECRET=
# Set only at launch after importing historical Ko-fi monthly payments.
# PREMIUM_KOFI_GRANDFATHER_CUTOFF=2027-01-01T00:00:00.000Z
# PREMIUM_SUBSCRIPTIONS_ENABLED=false
# PREMIUM_ACCESS_ENABLED=false
# Independent MCP kill switch. Leave unset in Production until launch.
# PREMIUM_MCP_ENABLED=false
# Dedicated signing key for the OAuth consent form (32+ random characters).
# MCP_OAUTH_SIGNING_SECRET=
# STRIPE_PREMIUM_PRICE_ID=
# STRIPE_PREMIUM_PORTAL_CONFIG_ID=
# PREMIUM_KOFI_JOIN_URL=https://ko-fi.com/meadtools
